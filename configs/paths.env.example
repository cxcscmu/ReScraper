# Copy to configs/paths.env, edit, and `source configs/paths.env` before running anything.
# Every script in this repository reads its locations from these variables; nothing is hard-coded.

# --- code ---------------------------------------------------------------------------------------------------
export RESCRAPER_ROOT=/path/to/rescraper-release     # this repository (SLURM scripts need it: sbatch copies scripts)
export DCLM_DIR=/path/to/dclm                         # upstream DCLM checkout + pretraining/dclm_patches (see pretraining/README.md)

# --- data and outputs ---------------------------------------------------------------------------------------
export WORK_DIR=/path/to/work                         # root of all data and outputs (several TB for the full pool)
export SFT_DIR=$WORK_DIR/sft_data                     # SFT seed pages, teacher labels, base/Stage-1/Stage-2 sets, prepacks
export CKPT_DIR=$WORK_DIR/ckpts                       # stage1/, stage2/ student checkpoints
export PRETRAIN_DIR=$WORK_DIR/pretrain                # DCLM pretraining runs (400m/, 1b/)
export CORE_DIR=$WORK_DIR/core                        # Core score tables (pretraining/core_sheet.sh)
export HTML_POOL_DIR=$WORK_DIR/pools/dclm-pool-400m-1x-html-jsonl-step3a-10pct   # raw-HTML source pool (DCLM 400m-1x, 10% of shards)
export DRIPPER_STEP1_DIR=$WORK_DIR/dclm_pipeline/dripper/step1_inference   # Dripper main-content inference over the pool
export DRIPPER_STEP2_DIR=$WORK_DIR/dclm_pipeline/dripper/step2_text        # Dripper main_html -> text
export HELDOUT_SHARDS=$WORK_DIR/heldout_shards.txt    # shard stems reserved for held-out evaluation (one per line)
export HF_HOME=$WORK_DIR/hf_cache
export LID_MODEL=$DCLM_DIR/baselines/mappers/enrichers/language_id_enrichment_models/lid.176.bin

# --- held-out evaluation and baselines (defaults shown; only override if your layout differs) -----------
# export EVAL_DIR=$WORK_DIR/eval                       # heldout5k/, heldout960/, heldout_pipeline/, extraction/, keep_judge/, diversity/
# export POOL_SIMP_DIR=...                             # simplified-HTML pool rows referenced by the earlier held-out table
# export RESILIPARSE_EXTRACT_DIR=$WORK_DIR/dclm_pipeline/resiliparse/resiliparse_extract/resiliparse_extract/processed_data
# export TWO_STAGE_POOL_DIR=$WORK_DIR/dclm_pipeline/two_stage_pool
# export TEXT_DECISIONS_DIR=$WORK_DIR/dclm_pipeline/rescue_add/text_decisions
# export ULTRAX_RERUN_DIR=$WORK_DIR/dclm_pipeline/resiliparse_raw_ultrax
# export ABLATION_DIR=$WORK_DIR/dclm_pipeline/operation_ablation
# export HELDOUT3161_DIR=$SFT_DIR/heldout3161           # earlier 3,161-page staged held-out table (rows 0..3160 of heldout5k)
# export STAGE1_SFT_STEMS=$SFT_DIR/stems_1p5m.txt       # shard stems the Stage-1 SFT set was drawn from (excluded from held-out)
# export TWO_STAGE_SFT_SOURCE_GLOB="$SFT_DIR/step1_output/input_shard_*.jsonl"   # Dripper SFT source of the two-stage refiner
# export RESCRAPER_CORPUS_DIR=$WORK_DIR/dclm_pipeline/rescraper_corpus
# export PROXC_POOL_DIR=$WORK_DIR/dclm_pipeline/prox_c/text
# export RW_RULE_POOL_DIR=...                          # RefinedWeb-rule output of the pool (see evaluation/diversity/README.md)
# export DIV_DIR=$EVAL_DIR/diversity
# export UX_SRC=... UX_WORK=...                        # UltraX input / work dirs (see baselines/ultrax/README.md)
export JUDGE_MODEL=openai/gpt-oss-120b

# --- models -------------------------------------------------------------------------------------------------
export TEACHER_MODEL=Qwen/Qwen3.8-27B                 # refining teacher
export RW_MODEL="<REPRO_REPHRASER_1B>"                # the public RePro 1B rephraser (identifier withheld for anonymity)
export STAGE1_CKPT=$CKPT_DIR/stage1/checkpoint-2244   # Stage-1 epoch-2 checkpoint (Stage-2 initialization)
export STAGE2_CKPT=$CKPT_DIR/stage2/final             # the released ReScraper model
export TWO_STAGE_CKPT=$CKPT_DIR/two_stage_refiner/final
# Released artifacts (model, corpus, SFT data) will be published upon acceptance as <HF_ORG>/<MODEL> and <HF_ORG>/<DATASET>.

# --- python environments (see requirements/) ----------------------------------------------------------------
export REFINER_PY=/path/to/envs/refiner/bin/python    # vLLM 0.11.1 / transformers 4.57.6 / dripper 1.0.0
export TORCHRUN=/path/to/envs/refiner/bin/torchrun
export TEACHER_PY=/path/to/envs/teacher/bin/python    # environment that can serve Qwen3.8-27B
export DCLM_PY=/path/to/envs/dclm/bin/python          # DCLM training / eval
export DCLM_TORCHRUN=/path/to/envs/dclm/bin/torchrun
export PIPE_PY=/path/to/envs/dclm/bin/python          # DCLM data processing (tokenize_shuffle, rule mappers)
export JUDGE_PY=$REFINER_PY                           # gpt-oss-120b judges (vLLM 0.11.1)
export DATATROVE_PY=/path/to/envs/datatrove/bin/python  # datatrove 0.2.0 (FineWeb-rule baseline)

# --- SLURM --------------------------------------------------------------------------------------------------
# #SBATCH --partition=gpu / cpu lines in the scripts are placeholders. Override them per submission with -p, or
# globally with the variables below (sbatch reads SBATCH_PARTITION / SBATCH_ACCOUNT from the environment).
export GPU_PARTITION=gpu
export CPU_PARTITION=cpu
# export SBATCH_PARTITION=...
# export SBATCH_ACCOUNT=...
export WANDB_MODE=offline

     return []
 
 
+def resiliparse_extraction_modifier(page: Dict,
+                                    html_key: str = 'text',
+                                    out_key: str = 'text',
+                                    main_content: bool = True,
+                                    alt_texts: bool = False,
+                                    preserve_formatting: bool = True) -> List[Dict]:
+    """Replace raw HTML in `html_key` with Resiliparse-extracted plain text under
+    `out_key`. All other keys (e.g. metadata, warcinfo) pass through untouched.
+    Drops records whose extraction is empty."""
+    from resiliparse.extract.html2text import extract_plain_text
+    from resiliparse.parse.html import HTMLTree
+
+    html = page.get(html_key)
+    if not html:
+        return []
+    try:
+        tree = HTMLTree.parse(html)
+        text = extract_plain_text(tree,
+                                  main_content=main_content,
+                                  alt_texts=alt_texts,
+                                  preserve_formatting=preserve_formatting)
+    except Exception:
+        return []
+    if not text or not text.strip():
+        return []
+    page[out_key] = text
+    return [page]
+

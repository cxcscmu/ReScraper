diff --git a/ray_processing/process_no_ray.py b/ray_processing/process_no_ray.py
new file mode 100644
index 0000000..72d1ff1
--- /dev/null
+++ b/ray_processing/process_no_ray.py
@@ -0,0 +1,443 @@
+#!/usr/bin/env python3
+import argparse
+import importlib
+import boto3
+import json
+import os
+import pathlib
+import time
+import traceback
+import warnings
+from typing import Optional
+
+from tqdm import tqdm
+from yaml import safe_load
+
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from baselines.core import process_single_file
+from baselines.core.monitoring import FilterMonitor, MonitorScorer, FilterRecorder
+from ray_processing.utils import generate_untokenized_dataset_json, get_source_ref, get_source_ref_by_key
+from baselines.core.constants import GLOBAL_FUNCTIONS
+
+
+LOCAL_CHUNK = "local"
+
+
+def _load_builder(builder_path: str):
+    if ":" not in builder_path:
+        raise ValueError(f"Builder path '{builder_path}' must be of the form 'module.submodule:callable'.")
+    module_name, attr_name = builder_path.split(":", 1)
+    module = importlib.import_module(module_name)
+    builder = getattr(module, attr_name)
+    return builder
+
+
+def build_monitor_from_spec(monitor_spec, jsonl_relpath: str) -> FilterMonitor:
+    print("inside build_monitor_from_spec")
+    if monitor_spec is None:
+        return None
+    print("monitor:", monitor_spec)
+    spec = dict(monitor_spec)
+    output_dir = pathlib.Path(spec["output_dir"])
+    shard_name = os.path.splitext(os.path.basename(jsonl_relpath))[0]
+    shard_output_dir = output_dir / shard_name
+
+    scorers = []
+    for scorer_cfg in spec.get("scorers", []):
+        print("scorer", scorer_cfg)
+        builder_path = scorer_cfg.get("builder")
+        if builder_path is None:
+            raise ValueError("Each scorer entry must provide a 'builder' field.")
+        builder = _load_builder(builder_path)
+        params = scorer_cfg.get("params", {}) or {}
+        scorer = builder(**params)
+        if not isinstance(scorer, MonitorScorer):
+            raise TypeError(f"Builder '{builder_path}' did not return a MonitorScorer instance.")
+        scorers.append(scorer)
+
+    return FilterMonitor(
+        scorers=scorers,
+        output_dir=shard_output_dir,
+        sample_size=spec.get("sample_size", 128),
+        text_key=spec.get("text_key", "text"),
+        rng_seed=spec.get("rng_seed"),
+    )
+
+
+def build_recorder(base_dir: pathlib.Path, jsonl_relpath: str) -> FilterRecorder:
+    shard_name = os.path.splitext(os.path.basename(jsonl_relpath))[0]
+    return FilterRecorder(base_dir, shard_name)
+
+
+def parse_args():
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--source_ref_paths", type=str, nargs="+", help="Paths to untokenized dataset refs (comma or space separated)."
+    )
+    parser.add_argument(
+        "--raw_data_dirpath",
+        help="Path to the top data directory in the data hierarchy (from which to mirror the output path).",
+    )
+    parser.add_argument("--shard_list_file", type=str, default=None, help="File containing list of input shards.")
+    parser.add_argument(
+        "--shard_list_filters", type=str, nargs="+", help="List of substrings to filter the input shard list by."
+    )
+
+    parser.add_argument("--output_dir", required=True, help="Path to the output dir of the processed file.")
+    parser.add_argument(
+        "--readable_name", required=True, type=str, help="Name given to tokenized dataset and reference json."
+    )
+
+    parser.add_argument(
+        "--config_path",
+        default="baselines/baselines_configs/c4.yaml",
+        help="Path to the YAML file specifying the baseline.",
+    )
+    parser.add_argument(
+        "--source_name", type=str, default="dcnlp_beta_pool", help="The name of the source of the jsonl file."
+    )
+    parser.add_argument(
+        "--workers", type=int, default=1, help="If > 1, process_single_file will fan out across a process pool."
+    )
+    parser.add_argument("--overwrite", action="store_true", help="Overwrite results even if they already exist.")
+    parser.add_argument("--num_shards", type=int, default=None, help="Only run on the first N shards (for debugging).")
+
+    # NEW: range-based sharding for multi-node parallelism
+    parser.add_argument(
+        "--shard_start",
+        type=int,
+        default=0,
+        help="0-based index of the first shard to process after listing + filtering.",
+    )
+    parser.add_argument(
+        "--shard_count",
+        type=int,
+        default=None,
+        help="Number of shards to process starting from shard_start. If None, process all remaining shards.",
+    )
+
+    parser.add_argument(
+        "--ignore_failures", action="store_true", help="Skip steps if there are partial failures (use sparingly)."
+    )
+    parser.add_argument(
+        "--monitor_config",
+        type=str,
+        default=None,
+        help="Optional YAML file specifying per-filter quality monitoring (scorers, sample size, output).",
+    )
+    parser.add_argument(
+        "--filter_io_dump_dir",
+        type=str,
+        default=None,
+        help=(
+            "Directory for storing per-filter before/after JSONL snapshots. "
+            "If relative, resolved under the pipeline output directory. Defaults to "
+            "'<output_dir>/<config_name>/filter_snapshots/<readable_name>'."
+        ),
+    )
+
+    # NEW: option to disable filter snapshots entirely (only final outputs)
+    parser.add_argument(
+        "--disable_filter_io_dump",
+        action="store_true",
+        help="If set, do NOT write per-filter before/after JSONL snapshots; only final per-shard outputs are saved.",
+    )
+
+    # NEW: helpful for multi-node runs; avoid metadata write races
+    parser.add_argument(
+        "--skip_dataset_metadata",
+        action="store_true",
+        help="If set, skip writing exp_data/datasets/untokenized/<readable_name>.json.",
+    )
+
+    return parser.parse_args()
+
+
+def list_shard_files(
+    data_dirpath,
+    num_shards: Optional[int] = None,
+    shard_list_file: Optional[str] = None,
+    shard_list_filters=None,
+    shard_start: int = 0,
+    shard_count: Optional[int] = None,
+):
+    print("inside list_shard")
+    if shard_list_file is not None:
+        with open(shard_list_file, "r") as f:
+            shard_files = f.read().splitlines()
+    elif data_dirpath is not None:
+        # Check if it's a local path or S3 path
+        if data_dirpath.startswith("s3://"):
+            print("Inside s3")
+            s3 = boto3.resource("s3")
+            bucket_name, path_within_bucket = data_dirpath.replace("s3://", "", 1).split("/", 1)
+            print("PATH", path_within_bucket)
+            if not path_within_bucket.endswith("/"):
+                path_within_bucket = f"{path_within_bucket}/"
+            bucket = s3.Bucket(bucket_name)
+            shard_files = [
+                obj.key.replace(path_within_bucket, "", 1)
+                for obj in bucket.objects.filter(Prefix=path_within_bucket)
+                if all(excl not in obj.key for excl in ("/stats/", "global_stats.jsonl"))
+            ]
+        else:
+            # Local filesystem path
+            print("Inside local filesystem")
+            import glob
+
+            shard_files = [
+                os.path.basename(f)
+                for f in glob.glob(os.path.join(data_dirpath, "*.jsonl.gz"))
+                if all(excl not in f for excl in ("/stats/", "global_stats.jsonl"))
+            ]
+    else:
+        raise ValueError("Either shard_list_file or data_dirpath must be provided.")
+
+    if num_shards is not None:
+        shard_files = shard_files[:num_shards]
+
+    if shard_list_filters is not None:
+        shard_files = [s for s in shard_files if any(filt in s for filt in shard_list_filters)]
+
+    # Apply shard_start + shard_count slicing for multi-node parallelism
+    if shard_start or shard_count is not None:
+        if shard_start < 0:
+            raise ValueError("--shard_start must be >= 0")
+        end = None if shard_count is None else shard_start + shard_count
+        shard_files = shard_files[shard_start:end]
+
+    # print("RETURNING", shard_files)
+    return shard_files
+
+
+def process_local_chunk(
+    config_data,
+    raw_data_dirpath,
+    jsonl_relpath,
+    source_name,
+    base_output_path,
+    workers,
+    overwrite,
+    monitor_spec=None,
+    filter_dump_root: Optional[pathlib.Path] = None,
+):
+    try:
+        print("inside process_local_chunk")
+        monitor = build_monitor_from_spec(monitor_spec, jsonl_relpath) if monitor_spec else None
+        recorder = None
+        if filter_dump_root is not None:
+            recorder = build_recorder(filter_dump_root, jsonl_relpath)
+        _, _, pages_in, pages_out = process_single_file(
+            config_data=config_data,
+            raw_data_dirpath=raw_data_dirpath,
+            jsonl_relpath=jsonl_relpath,
+            source_name=source_name,
+            base_output_path=base_output_path,
+            workers=workers,
+            overwrite=overwrite,
+        )
+        return True, pages_in, pages_out
+    except Exception:
+        traceback.print_exc()
+        return False, 0, 0
+
+
+def main():
+    os.environ.setdefault("RAY_LOG_TO_STDERR", "0")
+    args = parse_args()
+
+    json_path = f"exp_data/datasets/untokenized/{args.readable_name}.json"
+
+    # Create parent directories if they don't exist
+    os.makedirs(os.path.dirname(json_path), exist_ok=True)
+
+    if not args.overwrite and os.path.exists(json_path) and not args.skip_dataset_metadata:
+        raise FileExistsError(
+            f"{json_path} already exists. Change --readable_name, delete the file, "
+            "or pass --overwrite (or use --skip_dataset_metadata for multi-node runs)."
+        )
+
+    if args.source_ref_paths is not None:
+        source_ref_paths = [p.strip() for paths in args.source_ref_paths for p in paths.split(",") if p.strip()]
+        source_refs = [get_source_ref(p) for p in source_ref_paths]
+        if len(source_refs) != 1:
+            raise ValueError("For now only one source is supported.")
+        args.raw_data_dirpath = source_refs[0]["dataset_url"]
+    else:
+        source_ref = get_source_ref_by_key(args.raw_data_dirpath, "dataset_url")
+        if source_ref is None:
+            warnings.warn(
+                f"Raw data path '{args.raw_data_dirpath}' not found in dataset references; proceeding without source refs."
+            )
+            source_refs = []
+        else:
+            source_refs = [source_ref]
+
+    config_path = args.config_path
+    output_dir = args.output_dir
+    source_name = args.source_name
+    config_name = os.path.basename(config_path).split(".")[0]
+    base_output_path = os.path.join(output_dir, config_name)
+
+    # Filter IO dump configuration (intermediate snapshots)
+    if args.disable_filter_io_dump:
+        filter_dump_root = None
+        print("Filter IO snapshots are DISABLED; only final per-shard outputs will be written.")
+    else:
+        if args.filter_io_dump_dir:
+            candidate = pathlib.Path(args.filter_io_dump_dir).expanduser()
+            if not candidate.is_absolute():
+                filter_dump_root = pathlib.Path(base_output_path) / candidate
+            else:
+                filter_dump_root = candidate
+        else:
+            filter_dump_root = pathlib.Path(base_output_path) / "filter_snapshots" / args.readable_name
+        filter_dump_root.mkdir(parents=True, exist_ok=True)
+        print(f"Filter IO snapshots will be written to {filter_dump_root}")
+
+    monitor_spec = None
+    if args.monitor_config:
+        with open(args.monitor_config, "r") as monitor_file:
+            monitor_spec = safe_load(monitor_file) or {}
+        output_override = monitor_spec.get("output_dir")
+        if not output_override:
+            output_override = os.path.join(base_output_path, "monitoring")
+        monitor_spec["output_dir"] = str(pathlib.Path(output_override).resolve())
+
+    with open(config_path, "r") as yaml_file:
+        config_data = safe_load(yaml_file)
+        config_data = {v["source"]: v for v in config_data}
+    source_data = config_data[source_name]
+    steps = source_data["steps"]
+
+    chunks = []
+    prev_step_global = True
+    for step in steps:
+        if "func" in step and step["func"] in GLOBAL_FUNCTIONS:
+            if not chunks:
+                raise RuntimeError("Using a global operation as the first step is not currently supported.")
+            chunks.append(step)
+            prev_step_global = True
+        else:
+            if prev_step_global:
+                chunks.append(LOCAL_CHUNK)
+            prev_step_global = False
+
+    true_start = time.time()
+    working_dir = args.raw_data_dirpath
+    overwrite = args.overwrite
+    shard_extension: Optional[str] = None
+    for idx, chunk in enumerate(chunks):
+        chunk_start = time.time()
+        step_name = LOCAL_CHUNK if chunk == LOCAL_CHUNK else chunk["func"]
+
+        shard_files = list_shard_files(
+            working_dir,
+            args.num_shards,
+            args.shard_list_file,
+            args.shard_list_filters,
+            shard_start=args.shard_start,
+            shard_count=args.shard_count,
+        )
+        # print("HERE", shard_files)
+        if not shard_files:
+            raise RuntimeError(f"No shards found for working dir '{working_dir}'.")
+        if shard_extension is None:
+            shard_extension = os.path.splitext(shard_files[0])[-1][1:]
+        print(f"Starting chunk {idx} with name {step_name}, # of input jsonls = {len(shard_files)}")
+
+        if chunk == LOCAL_CHUNK:
+            results = []
+            failed_shards = []
+            pages_in = pages_out = 0
+            for jsonl_relpath in tqdm(shard_files, desc=f"Chunk {idx} ({step_name})"):
+                success, shard_pages_in, shard_pages_out = process_local_chunk(
+                    config_data,
+                    working_dir,
+                    jsonl_relpath,
+                    source_name,
+                    base_output_path,
+                    args.workers,
+                    overwrite,
+                    monitor_spec,
+                    filter_dump_root,
+                )
+                results.append((success, shard_pages_in, shard_pages_out))
+                pages_in += shard_pages_in
+                pages_out += shard_pages_out
+                if not success:
+                    failed_shards.append(jsonl_relpath)
+
+            successes = sum(1 for success, _, _ in results if success)
+            failures = len(results) - successes
+
+            # After a local chunk, we read from processed_data/ in the next chunk
+            working_dir = os.path.join(base_output_path, "processed_data/")
+            overwrite = False
+
+            if failures > 0:
+                warnings.warn(
+                    f"Local chunk failed on {failures} shards out of {len(results)}. "
+                    "Re-run this chunk with the same YAML and without --ignore_failures."
+                )
+                if not args.ignore_failures:
+                    raise RuntimeError("Exiting due to local failures.")
+        else:
+            step = chunk
+            kwargs = {k: v for k, v in step.items() if k != "func"}
+            working_dir = GLOBAL_FUNCTIONS[step["func"]](working_dir, shard_files, base_output_path, **kwargs)
+
+            if idx == len(chunks) - 1 and base_output_path != working_dir:
+                print(f"Final sync required back to desired output path: {working_dir} -> {base_output_path}")
+                raise NotImplementedError(
+                    "Non-local final chunk produced results outside base_output_path; handle the sync manually."
+                )
+
+        print(f"Chunk time: {time.time() - chunk_start:.2f}s")
+
+    print(f"Total time: {time.time() - true_start:.2f}s")
+
+    if shard_extension is None:
+        shard_extension = next(
+            (
+                os.path.splitext(ref.get("data_key", ""))[-1][1:] or ref.get("data_key")
+                for ref in source_refs
+                if ref
+            ),
+            None,
+        )
+    if shard_extension is None and (bool(args.raw_data_dirpath) ^ bool(args.shard_list_file)):
+        fallback_root = args.raw_data_dirpath if args.shard_list_file is None else None
+        shard_files = list_shard_files(
+            fallback_root,
+            num_shards=1,
+            shard_list_file=args.shard_list_file,
